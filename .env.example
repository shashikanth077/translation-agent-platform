# Copy to .env. Every setting is a TAP_* environment variable (see src/tap/config.py).

# --- backends: "demo" runs fully offline with deterministic stand-ins -------------------
TAP_NMT_BACKEND=demo               # demo | libretranslate
TAP_LLM_BACKEND=demo               # demo | anthropic
TAP_QUALITY_BACKEND=demo           # demo | heuristic | llm | ml
# TAP_INTAKE_BACKEND=rules         # rules | llm (llm needs TAP_LLM_BACKEND=anthropic)

# --- real providers -----------------------------------------------------------------------
# TAP_LIBRETRANSLATE_URL=http://localhost:5000
# TAP_ANTHROPIC_API_KEY=            # never commit this
# TAP_LLM_MODEL=claude-sonnet-5-5

# --- storage ---------------------------------------------------------------------------------
# TAP_DATA_DIR=.tap-data
# TAP_CACHE_BACKEND=redis
# TAP_REDIS_URL=redis://localhost:6379/0

# --- security (required when TAP_ENV=prod) ---------------------------------------------------
# TAP_ENV=prod
# TAP_API_KEYS_JSON=[{"key":"<long random>","subject":"svc-portal","tenant_id":"acme","roles":["client"]}]

# --- observability (LangSmith picks these up automatically) --------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=translation-agent-platform
# LANGSMITH_HIDE_INPUTS=true        # keep regulated source text out of traces
# LANGSMITH_HIDE_OUTPUTS=true
